{
  "name": "@nofault/codegen",
  "version": "0.4.0",
  "description": "nofault code generator: ApiSpec -> module / controller / service / dto source files, with overridable templates",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates": {
      "types": "./templates/index.d.ts",
      "default": "./templates/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nofault/dsl": "workspace:*"
  }
}